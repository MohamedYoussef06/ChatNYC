# Optional. Hello-world routes boot without a database or provider keys.
# Copy to `.env` or `.env.local` (both are loaded; `.env.local` wins for duplicates).

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nyc_companion
CORS_ORIGINS=http://localhost:3000

# Paste your xAI / Grok API key here (primary name for this repo).
# Alias XAI_API_KEY is also accepted if GROK_API_KEY is empty.
GROK_API_KEY=
# XAI_API_KEY=
GROK_MODEL=grok-3-mini

BACKBOARD_API_KEY=
ELEVENLABS_API_KEY=

# Optional Google Directions key for live walking / driving / transit routes.
MAPS_API_KEY=
